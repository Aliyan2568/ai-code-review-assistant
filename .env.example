# Copy this file to .env and fill in real values.
# Never commit .env to git.

APP_NAME="AI Code Review Assistant"
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL connection string (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/code_review_db

# Groq API key (used in a later stage)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
